; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CYPURRPUNK"
config/version="0.1"
run/main_scene="res://scenes/game_screen.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="MeowCity1999"
config/features=PackedStringArray("4.7")

[autoload]

Controls="*res://scripts/controls.gd"
Settings="*res://scripts/settings.gd"
Seats="*res://scripts/seats.gd"
Sound="*res://scripts/sound.gd"
Net="*res://scripts/net.gd"
Events="*res://scripts/events.gd"
DevCapture="*res://scripts/dev_capture.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation=4

[rendering]

renderer/rendering_method.mobile="forward_plus"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true

[shader_globals]

psx_wobble={
"type": "float",
"value": 1.0
}
