[gd_resource type="Theme" format=3]

; MEOW-CITY 1999 HUD look: chunky monospace text with a dark outline + drop shadow, so it reads
; over the bright neon city, and sharp neon-edged boxes for the talk box and inventory
; (the same colours as the pixel menus in ui/menu_theme.tres, but drawn at full resolution).
; Used by scenes/ui/hud.tscn. Double-click this file in Godot's FileSystem dock to edit it in
; the Theme editor.
; Want your own font? Drop a .ttf / .otf into the project, then in the Theme editor set
; Default Font (or Label > Fonts > font) to it.

[sub_resource type="SystemFont" id="Font_hud"]
font_names = PackedStringArray("Consolas", "Lucida Console", "Courier New", "Monospace")
font_weight = 700

[sub_resource type="StyleBoxFlat" id="Btn_normal"]
content_margin_left = 12.0
content_margin_top = 4.0
content_margin_right = 12.0
content_margin_bottom = 4.0
bg_color = Color(0.1, 0.04, 0.16, 0.85)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.35, 0.8, 0.7)

[sub_resource type="StyleBoxFlat" id="Btn_hover"]
content_margin_left = 12.0
content_margin_top = 4.0
content_margin_right = 12.0
content_margin_bottom = 4.0
bg_color = Color(0.2, 0.06, 0.3, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.4, 1, 1, 1)

[sub_resource type="StyleBoxFlat" id="Btn_pressed"]
content_margin_left = 12.0
content_margin_top = 4.0
content_margin_right = 12.0
content_margin_bottom = 4.0
bg_color = Color(1, 0.35, 0.8, 0.9)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.8, 0.95, 1)

[sub_resource type="StyleBoxFlat" id="Btn_focus"]
draw_center = false
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.4, 1, 1, 0.8)

[sub_resource type="StyleBoxFlat" id="Panel"]
content_margin_left = 22.0
content_margin_top = 16.0
content_margin_right = 22.0
content_margin_bottom = 16.0
bg_color = Color(0.05, 0.02, 0.09, 0.92)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 0.35, 0.8, 0.8)
shadow_color = Color(1, 0.35, 0.8, 0.18)
shadow_size = 10

[sub_resource type="StyleBoxFlat" id="Scroll_bar"]
content_margin_left = 6.0
content_margin_right = 6.0
bg_color = Color(0.1, 0.04, 0.16, 0.6)

[sub_resource type="StyleBoxFlat" id="Scroll_grabber"]
content_margin_left = 6.0
content_margin_right = 6.0
bg_color = Color(1, 0.35, 0.8, 0.7)

[resource]
default_font = SubResource("Font_hud")
default_font_size = 20
Button/colors/font_color = Color(1, 0.85, 0.95, 1)
Button/colors/font_hover_color = Color(0.4, 1, 1, 1)
Button/colors/font_focus_color = Color(0.4, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.05, 0.02, 0.09, 1)
Button/colors/font_disabled_color = Color(0.5, 0.4, 0.55, 1)
Button/styles/normal = SubResource("Btn_normal")
Button/styles/hover = SubResource("Btn_hover")
Button/styles/pressed = SubResource("Btn_pressed")
Button/styles/focus = SubResource("Btn_focus")
Button/styles/disabled = SubResource("Btn_normal")
Label/colors/font_color = Color(0.9, 0.95, 1, 1)
Label/colors/font_outline_color = Color(0.04, 0.01, 0.08, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0.55)
Label/constants/outline_size = 6
Label/constants/shadow_offset_x = 2
Label/constants/shadow_offset_y = 3
PanelContainer/styles/panel = SubResource("Panel")
VScrollBar/styles/scroll = SubResource("Scroll_bar")
VScrollBar/styles/grabber = SubResource("Scroll_grabber")
VScrollBar/styles/grabber_highlight = SubResource("Scroll_grabber")
VScrollBar/styles/grabber_pressed = SubResource("Scroll_grabber")
