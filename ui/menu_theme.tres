content_margin_right = 5.0
content_margin_bottom = 1.0
fill_color = Color(0.03, 0.1, 0.16, 0.5)
border_color = Color(0.22, 0.72, 0.98, 0.15)
corner_length = 0.0

[sub_resource type="StyleBox" id="Btn_focus"]
script = ExtResource("1_box")
fill_color = Color(0, 0, 0, 0)
border_color = Color(0.55, 0.9, 1, 0.9)
corner_length = 3.0
corner_color = Color(1, 1, 1, 1)
glow_color = Color(0.3, 0.8, 1, 0.5)

[sub_resource type="StyleBox" id="Edit_normal"]
script = ExtResource("1_box")
content_margin_left = 4.0
