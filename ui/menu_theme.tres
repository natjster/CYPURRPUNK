[gd_resource type="Theme" load_steps=12 format=3]

; CYPURRPUNK menu look = the HUD's OCEAN-BLUE look (same colours as ui/hud_style.tres + ui/hud_theme.tres):
; translucent deep-blue boxes, thin bright-blue edges with brighter corner brackets, chunky monospace text.
; Used by the start menu, MY CAT, pause menu, settings menu, on-screen keyboard.
; The boxes are HudStyleBox (scripts/ui/hud_style_box.gd). Double-click this file in Godot's FileSystem
; dock to edit it in the Theme editor (click a style to change its colours in the Inspector).
; The menus are laid out on a 320 x 240 screen: 1 pixel here = 3 of the HUD's units.

[ext_resource type="Script" path="res://scripts/ui/hud_style_box.gd" id="1_box"]

[sub_resource type="SystemFont" id="Font_menu"]
font_names = PackedStringArray("Consolas", "Lucida Console", "Courier New", "Monospace")
font_weight = 700

[sub_resource type="StyleBox" id="Btn_normal"]
script = ExtResource("1_box")
content_margin_left = 5.0
content_margin_top = 1.0
content_margin_right = 5.0
content_margin_bottom = 1.0
fill_color = Color(0.03, 0.14, 0.24, 0.72)
border_color = Color(0.22, 0.72, 0.98, 0.35)
corner_length = 0.0

[sub_resource type="StyleBox" id="Btn_hover"]
script = ExtResource("1_box")
content_margin_left = 5.0
content_margin_top = 1.0
content_margin_right = 5.0
content_margin_bottom = 1.0
fill_color = Color(0.08, 0.3, 0.46, 0.9)
border_color = Color(0.55, 0.9, 1, 1)
corner_length = 3.0
corner_color = Color(1, 1, 1, 1)
glow_color = Color(0.3, 0.8, 1, 0.5)

[sub_resource type="StyleBox" id="Btn_pressed"]
script = ExtResource("1_box")
