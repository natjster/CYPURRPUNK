border_color = Color(0.55, 0.9, 1, 1)
corner_length = 3.0

[sub_resource type="StyleBox" id="Panel"]
script = ExtResource("1_box")
content_margin_left = 8.0
content_margin_top = 6.0
content_margin_right = 8.0
content_margin_bottom = 6.0
fill_color = Color(0.02, 0.09, 0.16, 0.9)
border_color = Color(0.22, 0.72, 0.98, 0.88)
corner_length = 7.0

[sub_resource type="StyleBoxFlat" id="Scroll_bar"]
