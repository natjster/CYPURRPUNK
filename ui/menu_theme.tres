[gd_resource type="Theme" format=3]

; MEOW-CITY 1999 menu look: dark purple boxes, neon pink edges, cyan when the mouse is over it.
; Used by the start menu, pause menu and settings menu. Double-click this file in Godot's
; FileSystem dock to edit the colours in the Theme editor.

[sub_resource type="StyleBoxFlat" id="Btn_normal"]
content_margin_left = 4.0
content_margin_top = 1.0
content_margin_right = 4.0
content_margin_bottom = 1.0
bg_color = Color(0.1, 0.04, 0.16, 0.85)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.35, 0.8, 0.7)

