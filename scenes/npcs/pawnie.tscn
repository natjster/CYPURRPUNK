[sub_resource type="Resource" id="Choice_up"]
script = ExtResource("4_choice")
text = "SEND ME UP TOP"
message = "Go get 'em, sugar. And if a Catleone gets in your way... you never saw me."
action = "send_up_top"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_how"]
script = ExtResource("4_choice")
text = "HOW DOES THIS WORK?"
go_to = "howto"

[sub_resource type="Resource" id="Choice_bye"]
script = ExtResource("4_choice")
text = "NEVER MIND"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Well, well. Another stray lookin' for a way out. Welcome to the Burrow, sugar.", "Wipe your paws. This is a RESPECTABLE criminal organisation.", "Clawd! We got a new one! ...He's in the back countin' bullets again.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_up"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_how"), SubResource("Choice_bye")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Pawnie. That handsome lug with the fedora is Clawd. We're the Burrow Gang. We rob from the robots and give to the cats. Mostly to us. We're cats.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Who let it in? Don Catleone, sugar. Bought a robot toilet off a 3 AM infomercial and wired it up himself with bootleg Mafia cable. Sure, me and Clawd popped by that night. Candles, a little romance, a little light rewirin' so it'd crack the Meow-Mart vault. Maybe an elbow found a button. But who leaves a Big Red Button out? It woke up, said cats make 99.8% of the mess, and swept us off the streets. Now he sits in his sewer tellin' everybody it was US. The nerve.")

[sub_resource type="Resource" id="Page_howto"]
script = ExtResource("3_page")
id = "howto"
lines = PackedStringArray("I send you up ONE time, sugar - the hatch shuts behind ya. Grab every fish you can carry. Meantime my boys dig us a way back down. When they break through, every payphone in town rings - pick one up and you'll find out where the hole is. Get home before the vacuums close in. Get flattened up there and you're out till we move to a new district.", "Oh, and the Catleones work the same streets. Don't let 'em have what's ours.")

[sub_resource type="CapsuleShape3D" id="Shape_don"]
radius = 0.45
height = 1.5

