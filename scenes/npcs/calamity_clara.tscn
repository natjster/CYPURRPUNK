[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Shader" path="res://shaders/psx_lit.gdshader" id="2_psx"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "ANY BOUNTIES GOING?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "See you, or I won't."

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "I'LL TAKE THAT BOUNTY"
message = "Then we're in business. Don't make me collect on you."
action = "quest:gang_disrespect"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "Suit yourself. There's a bounty on cowards too. It's low."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "Shoot straight."

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_onmyway"]
script = ExtResource("4_choice")
text = "ON MY WAY"
message = "Don't die with my money."

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "POST ANOTHER BOUNTY"
message = "That's the spirit. Audacity pays."
action = "quest:gang_disrespect"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "See you, or I won't."

[sub_resource type="Resource" id="Page_ready"]
script = ExtResource("3_page")
id = "ready"
lines = PackedStringArray("Word travels fast. That's a fine piece of outlawin'. Now get home alive, or it's worth nothin'.", "I heard. Now get to that hatch, before they put a price on YOU.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onmyway")])
only_if_quest = "gang_disrespect"
only_if_state = "ready"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("Bounty's still open. I ain't seen a poster with your name on it yet.", "Tin Sheriff. Pockets. Or a good hard smack. I'm not particular.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "gang_disrespect"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("Two hundred, as agreed. You've got nerve. Another poster just went up. Interested?", "They're sayin' your name in the Catleone sewer. Not nice words. Good work. Again?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "gang_disrespect"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Got one eye left, and it's on you.", "I've collected on eleven robots, four Catleones and a horse. The horse had it comin'.", "Keep your paws where I can see 'em. That's the left side. I can't see the right.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "gang_disrespect"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("Two hundred dollar outlaw bounty, payable for pure audacity. Bag the Tin Sheriff, that's the MEGA VAC-COP. Rob a Catleone mobster blind in the street. Or walk up and smack one of Don's goons silly with somethin' heavy. Any one'll do. Then get home with it. A dead outlaw collects nothin'.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Calamity Clara. Bounty hunter, sometime outlaw, full-time pain in the neck. Lost the eye to a Dyson with a grudge. It's in a jar. The eye. The Dyson's in several jars.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Don Catleone paid good money for that machine and never read the manual. There's a bounty on the fella who sold it. There's a bigger one on Don. Pawnie and Clawd? Young love and a button. I don't collect on young love. Not unless it pays.")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("Destroy a MEGA VAC-COP, rob a downed rival, or land a melee hit on a rival. One of those, then extract. Get knocked out and I don't pay.")

