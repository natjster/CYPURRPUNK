[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Shader" path="res://shaders/psx_lit.gdshader" id="2_psx"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "WHAT DO YOU NEED?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "...oh. Okay. I'll just be here. In the box. Alone. It's fine."

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "FINE. THREE FISH."
message = "YOU'RE THE BEST. I'll be right here. Starving. No pressure."
action = "quest:mittens_fish"

[sub_resource type="Resource" id="Choice_alot"]
script = ExtResource("4_choice")
text = "THAT'S A LOT OF FISH"
go_to = "guilt"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NO"
message = "Wow. Okay. I'll just eat this cardboard then. Again."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "Hurry! I can feel my ribs! (I could always feel my ribs.)"

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_onmyway"]
script = ExtResource("4_choice")
text = "ON MY WAY"
message = "GO GO GO. Mind the vacuums!"

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "FINE. THREE MORE."
message = "I KNEW you loved me. Three fish. Same hatch. Same hundred bucks."
action = "quest:mittens_fish"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "I'll count the seconds. One... two... (please hurry)"

[sub_resource type="Resource" id="Page_ready"]
script = ExtResource("3_page")
id = "ready"
lines = PackedStringArray("I can SMELL them. Three fish! Why are they still in YOUR bag?! Get them down the exit hatch so they get to me! That's how the pipes work! Probably!", "You HAVE them?! Don't look at me, find the HATCH. Go! Extract! Before I eat your tail!")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onmyway")])
only_if_quest = "mittens_fish"
only_if_state = "ready"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("Are those fish? No? Then why are you HERE? ...Sorry. I get hangry. I love you. Go.", "My stomach just made a noise like a Roomba. That can't be good.", "Is it fish o'clock? It feels like fish o'clock. It's been fish o'clock for an hour.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind")])
only_if_quest = "mittens_fish"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("You came back! I ate all three fish in four seconds. New record. I'm hungry again. Same deal? A hundred bucks. I found more money. Still don't ask.", "MY HERO. My big strong hero. Who is about to bring me three more fish. Right? RIGHT?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "mittens_fish"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Oh thank goodness, a FACE. Do you know how long it's been since anyone talked to me? Eleven minutes. ELEVEN.", "Hi. Hello. Are you busy? You look busy. I'll be quick. I'm STARVING. Also lonely. Mostly starving.", "Nobody ever visits the box. It's a very nice box. Please don't leave. Please.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "mittens_fish"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("THREE fish. Up top they just leave 'em lying outside Meow-Mart. Three, not two. Two is a snack. Three is a MEAL. Bring all three down through the exit hatch and I'll give you a hundred bucks. I found it. Don't ask where.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_alot"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_guilt"]
script = ExtResource("3_page")
id = "guilt"
lines = PackedStringArray("It's three. I counted them on my toes. I have eighteen toes, so I'm basically a math professor. Look at my eyes. LOOK AT THEM. Please?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("I'm Lil' Mittens. I live in the box. I'm practically a made cat. Don Catleone says I'm \"a lot\". I think it's a compliment. Is it a compliment? Tell me it's a compliment.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("The Don bought a robot litter box so nobody has to scoop. I offered to scoop! For fish! Then the Burrow's Clawd leaned on the Big Red Button on a date, and now all the fish are locked in Meow-Mart. So really, they stole my lunch. As a made cat, I take that personally.")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("Three fish. In your bag. ALL three at once. Then climb down the exit hatch. It's not complicated! ...Sorry. Love you. Go.")

