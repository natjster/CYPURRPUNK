[sub_resource type="Resource" id="Choice_up"]
script = ExtResource("4_choice")
text = "SEND ME UP TOP"
message = "Go. And if the vacuums get you... I never met you."
action = "send_up_top"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_how"]
script = ExtResource("4_choice")
text = "HOW DOES THIS WORK?"
go_to = "howto"

[sub_resource type="Resource" id="Choice_bye"]
script = ExtResource("4_choice")
text = "NEVER MIND"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Ayyy, look what crawled outta the litter box. You want work? I got work.", "Welcome to the Sewers, kid. Nobody shoots down here. Nobody. Capisce?", "The city up there is crawlin' with fish, and nobody's guardin' 'em. Well. Almost nobody.", "You come to me, on the day of my nap, and you ask for a JOB?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_up"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_how"), SubResource("Choice_bye")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Don Catleone. I run these pipes. Nine lives, kid - I spent eight of 'em gettin' here. Don't make me spend the ninth on you.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Who let it in? I'll tell ya who. Three in the mornin', I can't sleep, the fella on the TV says NEVER SCOOP AGAIN. So I order one. A luxury litter box, kid, so my boys don't gotta scoop. A GIFT. Same night, Pawnie and Clawd sneak into my Mainframe room on a candlelit DATE, hotwire my machine to crack the Meow-Mart vault, and that lug leans his elbow on the Big Red Button. It wakes up, does the math, decides cats are the mess. Now they sit in their burrow tellin' everybody it was ME. I just wanted clean sand.")

[sub_resource type="Resource" id="Page_howto"]
script = ExtResource("3_page")
id = "howto"
lines = PackedStringArray("OVERCLEAN runs the streets now, kid. Us strays eat rats down here. Not no more. I send you up ONE time - the hatch shuts behind ya. Up there, you grab every fish that ain't nailed down. Meantime my boys dig for a new way back down. Every pipe we know, OVERCLEAN's got plugged, so it takes a while. When they break through, every payphone in town rings. Pick one up, I'll tell you where the hole is. Once you're all home, I seal it behind ya. And if the vacuums come in force first? I seal it anyway. Whoever's still up there... gets vacuumed.", "And if you get flattened up there? You're done for the night, kid. No second trip till we move to a new district.")

