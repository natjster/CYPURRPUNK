[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]
[ext_resource type="PackedScene" path="res://scenes/cat_model.tscn" id="9_catmodel"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "WHAT'S THE STUNT?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "ZOOM"

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "I'LL MAKE THE FRONT PAGE"
message = "YES YES YES. Headline: CAT DOES THING. Go go go."
action = "quest:daredevil_extract"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "Boooo. Boo. Sorry. Boo."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "GOGOGOGO"

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "AGAIN, AGAIN"
message = "WOOOOO"
action = "quest:daredevil_extract"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "ZOOM"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("Is it 85 yet? Is it now? Now? What about now?", "Don't leave early! Leavin' early is just walkin' home!")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "daredevil_extract"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("FRONT PAGE! I made it myself! It says YOU WIN, in crayon! Again? AGAIN?", "You came down that hole with the sirens screamin'! I felt it in my pupils! Same hundred fifty!")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "daredevil_extract"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("WHOA hi hi hi are you fast? I'm fast. I can taste the air. It tastes like catdip.", "Saw a stunt once. It was me. I did it. I did it again just now. Did you see? You blinked.", "Everything's so SLOW down here. Why's everybody so SLOW.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "daredevil_extract"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("A robbery don't make the front page unless you escape with the sirens wailin'! Eighty-five heat! Stay up top till it hits 85, then get to the hatch ALIVE! Hundred fifty cash and your name in the papers! I don't have papers! I have this hundred fifty!")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Jax! Stunt-cat! Outlaw! Burrow's fastest! Pawnie says I'm \"a liability\". I looked it up. I can't read. I think it means fast.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("It was the Don! No wait! Clawd's elbow! No! The toaster! THE TOASTER WOKE UP! Don's bootleg wires go ZZZT, Clawd goes OOPS, and it goes 99.8 PERCENT! Best night of my life and I missed it! Catleones started it! I checked!")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("Extract at 85 heat or more! Check the bar! The hatch seals at 100, so don't get too cute! Or do! Headlines!")

[sub_resource type="CapsuleShape3D" id="Shape_cat"]
radius = 0.3
height = 0.9

