[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Shader" path="res://shaders/psx_lit.gdshader" id="2_psx"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "WHAT'S THE JOB?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "Keep your tail tucked, kid."

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "FIVE TIN CANS. DONE."
message = "Atta cat. Make it hurt. Do they hurt? Make it look like it hurts."
action = "quest:smash_roombas"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "Yeah, walk away. That's what I said to the Dyson. Look how that went."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "And check your tail on the way out. I'm serious."

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_onmyway"]
script = ExtResource("4_choice")
text = "ON MY WAY"
message = "Don't look back. They come from behind. I know."

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "FIVE MORE TIN CANS"
message = "Salute. For the tail."
action = "quest:smash_roombas"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "Keep your tail tucked, kid."

[sub_resource type="Resource" id="Page_ready"]
script = ExtResource("3_page")
id = "ready"
lines = PackedStringArray("FIVE? You did five?! Why are you standin' here? Get to the hatch! A kill ain't a kill till you're home with it.", "That's five in the ground. Now go extract before you make it zero.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onmyway")])
only_if_quest = "smash_roombas"
only_if_state = "ready"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("Five, I said. Not four. Four is what the Dyson left of my tail.", "You hear a hum just now? Tell me you didn't hear a hum.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "smash_roombas"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("Five tin cans, swimmin' with the fishes. I slept like a kitten last night. Same again? Same hundred fifty.", "You hear that? Nothin'. Beautiful. Now there's more of 'em. Go again?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "smash_roombas"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Don't say the V-word. Don't say it. ...Vacuum. AAGH. See what you made me do?", "See this tail? Used to go all the way out to HERE. Then '98 happened. A Dyson happened.", "Them floor appliances ain't payin' protection. Ain't NEVER paid protection. That's an insult to the Family.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "smash_roombas"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("Five VAC-COPs. Gun, bat, run 'em down with the car, I don't care. Send five of those tin cans sleepin' with the fishes, then get home in one piece and I pay you a hundred fifty. But you get flattened, the count goes back to zero. The Family don't pay for rumours.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Paulie \"No-Brooms\". I don't do brooms, I don't do mops, I don't do Dysons. I do collections. Least I did, till a floor appliance took half my tail and all my confidence.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("The Don ordered a litter box off the TV, God bless him, and them Burrow lovebirds woke it up on a date. Clawd's elbow, kid. Now every floor appliance in town is armed. You know how I feel about floor appliances?")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("Smash five VAC-COPs yourself. Gun, bat or car. Then extract. Get knocked out and the count's back to nothin'.")

