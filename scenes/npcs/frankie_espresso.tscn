[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]
[ext_resource type="PackedScene" path="res://scenes/cat_model.tscn" id="9_catmodel"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "WHAT'S THE BET?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "Don't blink! I never do!"

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "YOU'RE ON"
message = "Atta cat! I'm puttin' you down at nine to one! Don't tell me if you die, I got a heart thing."
action = "quest:daredevil_extract"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "Smart. Boring, but smart. The odds on boring are terrible."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "Finish your cannoli, kid!"

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "ONE MORE TIME"
message = "That's the stuff! I'm gettin' another espresso!"
action = "quest:daredevil_extract"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "Don't blink! I never do!"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("Eighty-five heat, kid! Up top, on your feet, and then you hit the hatch. Sooner don't count!", "You're still breathin'? That messes up my whole board.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "daredevil_extract"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("You did it?! AT EIGHTY-FIVE?! I lost nine grand! Best night of my life! Double or nothin'? It's just nothin'. Same hundred fifty.", "Kid, you're a legend. Everybody who bet on you is a genius, and that was nobody. Again?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "daredevil_extract"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Heyheyhey, kid, kid, you want action? I got action. Fourteen espressos. Pinch of catnip. I can hear colours.", "Numbers, kid! I run the Family's numbers! You know what the odds are you survive tonight? Don't ask. Ask me. Nine to one. Against.", "I ain't blinked since Thursday. Is it Thursday?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "daredevil_extract"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("Here's the action. Anybody can run home when the sirens start. I got a hundred fifty says you ain't got the nerve to stay up top till the heat hits 85, then extract ALIVE. A real wise-cat don't run when the sirens start - he finishes his cannoli!")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Frankie \"Espresso\". I keep the books. The books are mostly napkins. I had a good feelin' about this one napkin, but then I drank it.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Oh I had odds on that! Don buys a litter box, Clawd leans on the Big Red Button, machine wakes up mad at all cats? That was a THREE-WAY PARLAY, kid, four thousand to one, and nobody took it! Each side says it was the other side! I'm takin' bets on that too!")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("Eighty-five heat or higher when you extract. Watch the bar top-right. Go too early, no payout. Wait till the hatch seals at 100? No payout AND you get vacuumed.")

[sub_resource type="CapsuleShape3D" id="Shape_cat"]
radius = 0.3
height = 0.9

