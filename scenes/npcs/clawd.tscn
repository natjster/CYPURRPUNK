[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/shopkeeper.gd" id="1_script"]
[ext_resource type="Shader" path="res://shaders/psx_lit.gdshader" id="2_psx"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]

[sub_resource type="Resource" id="Choice_shop"]
script = ExtResource("4_choice")
text = "SHOW ME THE GOODS"
action = "shop"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_bye"]
script = ExtResource("4_choice")
text = "LATER, CLAWD"
message = "Keep your head down. And keep your paws off my hat."

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Clawd. Guns, gear, getaway snacks. Pawnie does the talkin'.", "You lookin' to buy or lookin' at my hat? Hat's not for sale.", "Make it quick, pal. I got bullets to count. I lost count. Again.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_shop"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_bye")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Clawd. Driver, shooter, Pawnie's better half. She'd say worse half. She'd be wrong. Everything I sell fell off a VAC-COP. Usually after I shot it.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Pawnie tell you about the big red button? ...Yeah. Catleone did that. We were NOT on a date at the Mainframe that night. We were... guardin' it. Real close up. With candles. Look, you buyin' or not?")

