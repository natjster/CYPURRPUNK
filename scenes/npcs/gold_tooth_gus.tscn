[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Shader" path="res://shaders/psx_lit.gdshader" id="2_psx"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "WHAT ARE YOU AFTER, GUS?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "Hmph."

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "ONE GOLDEN KOI"
message = "Heh. That's what I said in '61. Don't get caught with it."
action = "quest:golden_koi_heist"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "Hmph. Kids today. Nobody wants the Big Score."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "Hmph. Good."

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_onmyway"]
script = ExtResource("4_choice")
text = "ON MY WAY"
message = "Hmph. Don't drop it."

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "ONE MORE BIG SCORE"
message = "Hmph. Now you're learnin'."
action = "quest:golden_koi_heist"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "Hmph."

[sub_resource type="Resource" id="Page_ready"]
script = ExtResource("3_page")
id = "ready"
lines = PackedStringArray("I can see that glint from here. Don't stand there! A score ain't a score till it's home.", "Beautiful. Now get to the hatch before a Catleone puts his greasy paws on it.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onmyway")])
only_if_quest = "golden_koi_heist"
only_if_state = "ready"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("Still no gold? Hmph.", "A real score takes patience. You got till the sirens stop bein' funny.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "golden_koi_heist"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("...Would you look at that. Forty years, and it still gets me. One more, kid. Same two-fifty.", "That's the stuff. Don't tell Clawd. He'll ask to borrow it.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "golden_koi_heist"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Hmph. Forty years crackin' safes and I end up in a sewer with a lovesick driver.", "Mind the tooth. Everyone stares at the tooth. It's 24-karat. Paid for it with a bank.", "Clawd borrowed my best picks for a \"romantic evenin'\". They came back bent. All of 'em.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "golden_koi_heist"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("The Big Score, kid. The 24-karat Fort Knox of Fish: the Golden Koi. OVERCLEAN's got 'em in with the rest of the bait. One of 'em, in your bag, down the hatch. Two hundred fifty from me, and the koi still fetches its price. I don't want the money. I want to look at it.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("\"Gold-Tooth\" Gus. Oldest safe-cracker in the Burrow. Taught Pawnie everything she knows. Should've taught her not to lend my tools to Clawd.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Pawnie and Clawd had a fine plan. Hotwire Don's new machine into a vault-cracker, hit Meow-Mart. With MY tools. Then Clawd gets romantic and leans on a button. But who wires a button that size to a litter box? Catleone's fault. Mostly. Clawd still owes me a set of picks.")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("One Golden Koi, in your bag, out the exit hatch. Get knocked out and you'll drop it on the street for the next fool.")

