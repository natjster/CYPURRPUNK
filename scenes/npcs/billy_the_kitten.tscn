[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Shader" path="res://shaders/psx_lit.gdshader" id="2_psx"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]
[ext_resource type="PackedScene" path="res://scenes/cat_model.tscn" id="9_catmodel"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "WHAT DO YOU WANT, BILLY?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "This town ain't big enough for the two of us. It's a box."

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "FINE, THREE FISH"
message = "HA HA! Another victim! Thanks! Hurry! Please!"
action = "quest:mittens_fish"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "You got lucky, stranger. My stomach's got your scent."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "Ride like the wind!"

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_onmyway"]
script = ExtResource("4_choice")
text = "ON MY WAY"
message = "Yee-haw! Mind the vacuums!"

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "STICK ME UP AGAIN"
message = "HA HA! Same hatch, same hundred bucks!"
action = "quest:mittens_fish"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "This town ain't big enough for the two of us. It's a box."

[sub_resource type="Resource" id="Page_ready"]
script = ExtResource("3_page")
id = "ready"
lines = PackedStringArray("THE LOOT! You got the LOOT! Don't hand it to me, that's not how the hatch works! Extract! Yee-haw!", "I can SMELL it from the fort! Go! Get down the hatch before the Tin Sheriff finds you!")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onmyway")])
only_if_quest = "mittens_fish"
only_if_state = "ready"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("My stagecoach is runnin' low on supplies. The supplies are fish.", "I'd rob you, but you ain't got the fish yet, have you.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "mittens_fish"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("Three fish, four seconds. Fastest paws in the Burrow. I'm hungry again. This is ANOTHER stick-up.", "You came back! Nobody comes back to a stick-up! Same deal? Hundred bucks?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "mittens_fish"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("STICK 'EM UP! This here's a stagecoach! That there's a robbery! ...Is it working?", "HALT, stranger! You're in Fort Outlaw territory! Pay the toll! The toll is talking to me.", "I'm the fastest paw in the Burrow. I once robbed a whole mouse. It was a toy. It still counts.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "mittens_fish"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("THIS IS A STICK-UP FOR THREE FISH! Three! Reach for the sky and bring 'em down through the exit hatch, or else! ...Or else I'll get real hungry. *stomach rumbles* Okay please hurry. There's a hundred bucks in it. I robbed it. From a jar.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("I'm Billy The Kitten, the meanest outlaw in the Burrow. Pawnie says I can have a real horse when I'm bigger. This box is my stagecoach. Don't look at it too hard or it's a box.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Don Catleone bought a robot toilet off the TV, and it got mad at everyone! Pawnie and Clawd were just on a date! It's not a crime to lean! ...I don't know what lean means. Clawd told me to say that.")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("Three fish, in your bag, ALL at once, down the exit hatch. That's how a stick-up works, pardner.")

