[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Shader" path="res://shaders/psx_lit.gdshader" id="2_psx"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "HOW DO I EARN RESPECT?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "Respect."

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "MESSAGE RECEIVED"
message = "Don't tell me about it. Let 'em tell me about it."
action = "quest:gang_disrespect"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "Keep walkin'. That was also a message."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "Right across the whiskers."

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_onmyway"]
script = ExtResource("4_choice")
text = "ON MY WAY"
message = "Walk. Don't run. Respect walks."

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "SEND ANOTHER MESSAGE"
message = "Good. Bring a bat."
action = "quest:gang_disrespect"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "Respect."

[sub_resource type="Resource" id="Page_ready"]
script = ExtResource("3_page")
id = "ready"
lines = PackedStringArray("I heard. Whole sewer heard. Now get home with it, or it never happened.", "That's respect. Now extract, before somebody disrespects you back.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onmyway")])
only_if_quest = "gang_disrespect"
only_if_state = "ready"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("Word ain't reached me yet. So it didn't happen.", "Message ain't sent till I hear it. Boss bot. Pockets. Or whiskers. Pick one.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "gang_disrespect"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("They're still talkin' about it up there. That's two hundred. There's always more disrespect to go around.", "Now THAT'S a message. Could use a follow-up.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "gang_disrespect"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("...", "You're lookin' at me. Why you lookin' at me? Is that respect? I'm askin'.", "They call me The Slapper. They don't call me that twice.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "gang_disrespect"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("RESPECT. Somebody's gotta send a message up top. Whack one of OVERCLEAN's MEGA VAC-COPs. Or empty a downed Burrow hick's pockets. Or slap a rival across the whiskers, with a bat, with a fish, I ain't fussy. Any one of 'em. Then get home with it. Two hundred bucks. You get knocked out first, you didn't send nothin'.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Sal. \"The Slapper.\" Button-man for the Family. I got one rule, and it's respect. Also I got this scar. Don't ask about the scar. That's the other rule.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("A hick in a fedora puts his elbow on the Family's Big Red Button, on OUR machine, in OUR room, and then says it was the Don? That ain't a mistake. That's DISRESPECT. It's the worst I ever seen, and I seen a lot.")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("Destroy a MEGA VAC-COP, rob a downed rival, or land a melee hit on a rival. One's plenty. Then extract. A knockout wipes it.")

