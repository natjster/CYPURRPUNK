[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]
[ext_resource type="PackedScene" path="res://scenes/cat_model.tscn" id="9_catmodel"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "WHAT DO YOU NEED, NONNA?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "Wear a sweater."

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "ONE GOLDEN KOI, NONNA"
message = "Good. Take a sweater. It's cold up there. It's always cold up there."
action = "quest:golden_koi_heist"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "Fine. I'll tell the Don you were busy. He'll be so disappointed. I'll see to it."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "Go. Eat something first."

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_onmyway"]
script = ExtResource("4_choice")
text = "ON MY WAY"
message = "And don't run with it! ...No, run with it."

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "ANOTHER KOI, NONNA"
message = "Good cat. Better than my grandson. Don't tell him. Tell him."
action = "quest:golden_koi_heist"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "Wear a sweater."

[sub_resource type="Resource" id="Page_ready"]
script = ExtResource("3_page")
id = "ready"
lines = PackedStringArray("Is that GOLD I smell? What are you doing here with it? The hatch! Go, go, before some Burrow hick puts his dirty paws on my gravy!", "Mamma mia, look at the shine on it. Now extract, before I hit you with this spoon.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onmyway")])
only_if_quest = "golden_koi_heist"
only_if_state = "ready"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("The sauce has been on since Tuesday. Where is my koi?", "I am not angry. I am only very, very old, and the sauce is getting thick.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "golden_koi_heist"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("THAT is a fish. Sit. Eat. ...You ate? Eat again. I need another one for next Sunday. It's a big family.", "The Don cried when he tasted it. He cries a lot. One more, for the freezer?")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "golden_koi_heist"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("Sit. Eat. You look like a coat hanger with whiskers. Who's feeding you? Nobody. I can tell.", "My grandson runs this family. MY grandson. I changed his litter. And what did he do? He bought a robot to do it.", "Sunday Gravy waits for no cat, and I will not make it with PEASANT sardines.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "golden_koi_heist"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("Sunday Gravy needs a proper fish. Not a sardine. Not that thing with the sad eyes. I want the 24-karat Golden Koi, the one OVERCLEAN locked up with the rest. Bring one home in your bag and I give you two hundred fifty, on top of what it fetches. And wash your paws.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("I am Nonna. His Nonna. Everybody's Nonna. I buried three husbands and two of them were on purpose. You will finish your plate.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Who let it in? My grandson! Too lazy to scoop, so he orders a robot litter box off the television at three in the morning! In MY day you scooped with your own paw and you said thank you! Then those two Burrow hooligans go kissing in the machine room. Candles! Near WIRING! Nobody listens to Nonna.")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("One Golden Koi, in your bag, down the exit hatch. If they flatten you, you drop it. Don't get flattened. I didn't raise you to get flattened.")

[sub_resource type="CapsuleShape3D" id="Shape_cat"]
radius = 0.3
height = 0.9

