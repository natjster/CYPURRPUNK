[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc.gd" id="1_script"]
[ext_resource type="Shader" path="res://shaders/psx_lit.gdshader" id="2_psx"]
[ext_resource type="Script" path="res://scripts/npcs/npc_page.gd" id="3_page"]
[ext_resource type="Script" path="res://scripts/npcs/npc_choice.gd" id="4_choice"]

[sub_resource type="Resource" id="Choice_need"]
script = ExtResource("4_choice")
text = "WHAT'S THE JOB, BENNY?"
go_to = "ask"

[sub_resource type="Resource" id="Choice_who"]
script = ExtResource("4_choice")
text = "WHO ARE YOU?"
go_to = "about"

[sub_resource type="Resource" id="Choice_city"]
script = ExtResource("4_choice")
text = "WHO LET OVERCLEAN IN?"
go_to = "blame"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("4_choice")
text = "GOTTA GO"
message = "Keep it between the ditches!"

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("4_choice")
text = "FLATTEN FIVE"
message = "Put your foot down! The other foot's for emergencies!"
action = "quest:smash_roombas"

[sub_resource type="Resource" id="Choice_no"]
script = ExtResource("4_choice")
text = "NOT TODAY"
message = "Fine. Walkin's legal too, I hear. Boring."

[sub_resource type="Resource" id="Choice_onit"]
script = ExtResource("4_choice")
text = "ON IT"
message = "Pedal to the metal!"

[sub_resource type="Resource" id="Choice_remind"]
script = ExtResource("4_choice")
text = "REMIND ME?"
go_to = "remind"

[sub_resource type="Resource" id="Choice_onmyway"]
script = ExtResource("4_choice")
text = "ON MY WAY"
message = "No brakes! They just slow you down!"

[sub_resource type="Resource" id="Choice_again"]
script = ExtResource("4_choice")
text = "FIVE MORE ROADBLOCKS"
message = "That's my kinda driver!"
action = "quest:smash_roombas"

[sub_resource type="Resource" id="Choice_notnow"]
script = ExtResource("4_choice")
text = "NOT RIGHT NOW"
message = "Keep it between the ditches!"

[sub_resource type="Resource" id="Page_ready"]
script = ExtResource("3_page")
id = "ready"
lines = PackedStringArray("FIVE! I felt it in the suspension! Now floor it to the hatch!", "That's five roadblocks gone! Extract, you maniac!")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onmyway")])
only_if_quest = "smash_roombas"
only_if_state = "ready"

[sub_resource type="Resource" id="Page_waiting"]
script = ExtResource("3_page")
id = "waiting"
lines = PackedStringArray("How many so far? Doesn't matter. MORE.", "I hear they crunch real nice at top speed. Better than a bump in the road.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_onit"), SubResource("Choice_remind"), SubResource("Choice_city")])
only_if_quest = "smash_roombas"
only_if_state = "active"

[sub_resource type="Resource" id="Page_thanks"]
script = ExtResource("3_page")
id = "thanks"
lines = PackedStringArray("Five! Look at this bumper! Art! Another run? Same hundred fifty.", "The highway's clear! Which means they sent more! Which means YES. Again.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_again"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_notnow")])
only_if_quest = "smash_roombas"
only_if_state = "done"

[sub_resource type="Resource" id="Page_hello"]
script = ExtResource("3_page")
id = "hello"
lines = PackedStringArray("You see this hat? Took it off a roadblock. Took the roadblock too. HA!", "Listen. LISTEN. You hear that engine? That's freedom. That's freedom with a bad gasket.", "They said no cat could drive through a police line. I said watch this. I been in hospital ever since. Worth it.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_need"), SubResource("Choice_who"), SubResource("Choice_city"), SubResource("Choice_leave")])
only_if_quest = "smash_roombas"

[sub_resource type="Resource" id="Page_ask"]
script = ExtResource("3_page")
id = "ask"
lines = PackedStringArray("Them VAC-COPs think they're highway patrol. No rolling badge-wearer puts a boot on OUR getaway car! Flatten five of 'em! Shoot 'em, whack 'em, or, and I can't stress this enough, RAM 'EM. Then get home and it's a hundred fifty. Get knocked out and I ain't countin' none of it.")
choices = Array[ExtResource("4_choice")]([SubResource("Choice_accept"), SubResource("Choice_no")])

[sub_resource type="Resource" id="Page_about"]
script = ExtResource("3_page")
id = "about"
lines = PackedStringArray("Benny. Getaway mechanic for the Burrow. I built the car, I fixed the car, and I crashed the car, in that order, nine times. The cone? It's a hat now.")

[sub_resource type="Resource" id="Page_blame"]
script = ExtResource("3_page")
id = "blame"
lines = PackedStringArray("Catleone wired that machine up himself! I saw the job! Speaker cable! Fuses made of tinfoil! A mechanic would've wept! Sure, Clawd bumped a button. You bump a good machine, it don't declare war on cats!")

[sub_resource type="Resource" id="Page_remind"]
script = ExtResource("3_page")
id = "remind"
lines = PackedStringArray("Five VAC-COPs, smashed by you. Gun, melee or car. Then extract. Knockout resets the count.")

